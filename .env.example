# Copieu aquest fitxer a .env i canvieu els valors. Mai feu commit del .env.

# Django
# També signa els tokens JWT: ha de tenir com a mínim 32 caràcters.
DJANGO_SECRET_KEY=canvieu-aquesta-clau-per-una-de-llarga-i-aleatoria
# True només en local. Sense aquesta variable, s'aplica la configuració de producció.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígens del frontend que poden cridar l'API, separats per comes.
# Si canvieu el FRONTEND_PORT, canvieu-lo també aquí.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Producció (DJANGO_DEBUG=False): vegeu els valors per a Render i Neon a la secció
# "Desplegament" del README.
# Orígens de confiança per al CSRF, amb l'esquema, separats per comes.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# True darrere d'un proxy que acabi l'HTTPS i enviï X-Forwarded-Proto, com Render.
DJANGO_PROXY_HTTPS=False
# Opcions amb valor per defecte segons DJANGO_DEBUG (descomenteu-les per canviar-lo).
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_COOKIE_SAMESITE=Lax

# Correu electrònic
# En local, amb DJANGO_DEBUG=True, Django mostra els correus a la consola.
DEFAULT_FROM_EMAIL=no-reply@localhost

# Producció: substituïu aquests valors pels del proveïdor SMTP.
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=usuari-smtp-exemple
EMAIL_HOST_PASSWORD=contrasenya-smtp-exemple
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# PostgreSQL
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=canvieu-aquesta-contrasenya
# Host: "127.0.0.1" si Django corre fora de Docker, "db" si corre dins del docker-compose.
# No poseu "localhost": a Windows prova primer ::1 (IPv6) i el contenidor només escolta a 127.0.0.1.
POSTGRES_HOST=127.0.0.1
# Port de la màquina local (canvieu-lo si ja teniu un PostgreSQL al 5432).
POSTGRES_PORT=5432
# Per defecte, prefer amb DJANGO_DEBUG=True i require sense (descomenteu-la per canviar-lo).
# POSTGRES_SSLMODE=require

# Ports de la màquina local per al backend i el frontend del docker-compose
# (canvieu-los si ja els teniu ocupats).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Correu de verificació (per defecte s'imprimeix a la consola del backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@bookit.local
PASSWORD_RESET_TIMEOUT=86400
