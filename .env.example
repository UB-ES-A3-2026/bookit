# Copieu aquest fitxer a .env i canvieu els valors. Mai feu commit del .env.

# Django
DJANGO_SECRET_KEY=canvieu-aquesta-clau
# True només en local. Sense aquesta variable, s'aplica la configuració de producció.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígens del frontend que poden cridar l'API, separats per comes.
# Si canvieu el FRONTEND_PORT, canvieu-lo també aquí.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Producció (DJANGO_DEBUG=False): cal un DJANGO_SECRET_KEY real i el domini real a
# DJANGO_ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS i CSRF_TRUSTED_ORIGINS.
# Orígens de confiança per al CSRF, amb l'esquema, separats per comes.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# True si un proxy acaba l'HTTPS i envia la capçalera X-Forwarded-Proto.
DJANGO_PROXY_HTTPS=False
# Opcions amb valor per defecte segons DJANGO_DEBUG (descomenteu-les per canviar-lo).
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_COOKIE_SAMESITE=Lax

# PostgreSQL
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=canvieu-aquesta-contrasenya
# Host: "127.0.0.1" si Django corre fora de Docker, "db" si corre dins del docker-compose.
# No poseu "localhost": a Windows prova primer ::1 (IPv6) i el contenidor només escolta a 127.0.0.1.
POSTGRES_HOST=127.0.0.1
# Port de la màquina local (canvieu-lo si ja teniu un PostgreSQL al 5432).
POSTGRES_PORT=5432

# Ports de la màquina local per al backend i el frontend del docker-compose
# (canvieu-los si ja els teniu ocupats).
BACKEND_PORT=8000
FRONTEND_PORT=5173
